{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "azuredevops-provider-kog-config values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceGroup": {
      "type": "string",
      "default": "azuredevops.krateo.io"
    },
    "configurationName": {
      "type": "string",
      "default": "azuredevops"
    },
    "secretName": {
      "type": "string",
      "default": "azuredevops-pat"
    },
    "usernameKey": {
      "type": "string",
      "default": "username"
    },
    "tokenKey": {
      "type": "string",
      "default": "token"
    },
    "kinds": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "enum": [
          "CheckApproval",
          "CheckExclusiveLock",
          "CheckRequiredTemplate",
          "CheckTask",
          "Environment",
          "Feed",
          "GitPush",
          "GitRepository",
          "Pipeline",
          "PipelinePermission",
          "PolicyBuildValidation",
          "PolicyRequiredReviewers",
          "PolicyStatus",
          "PullRequest",
          "Queue",
          "TeamProject"
        ]
      }
    }
  }
}
